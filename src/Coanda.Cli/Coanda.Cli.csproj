<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>coa</AssemblyName>
    <RootNamespace>Coanda.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Coanda.Core\Coanda.Core.csproj" />
    <ProjectReference Include="..\Coanda.Daemon\Coanda.Daemon.csproj" />
    <!--
      The software module, which ModuleComposition.cs builds and hands to the daemon; the daemon references
      no module. Its manifest and definitions are copied to modules/software/ beside coa.
    -->
    <ProjectReference Include="..\Coanda.Modules.Software\Coanda.Modules.Software.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Coanda.Tests" />
  </ItemGroup>

</Project>
