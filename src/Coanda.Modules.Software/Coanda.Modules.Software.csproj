<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The software engineering module: the worktree, gates, open-pr, gated-merge, and rebase steps, the
    GitHub client they reach GitHub through, and the clone and worktree code they call. It references
    the module SDK and no other Coanda project, so it reaches the core only through the SDK's client for
    the core's loopback API; a test over this file holds that.
  -->
  <PropertyGroup>
    <RootNamespace>Coanda.Modules.Software</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Coanda.Sdk\Coanda.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The module's manifest and its definitions folder, one JSON file per type, flow, and agent. They are
      copied to modules/software/ beside the assembly of whatever builds on this project, the daemon's
      among them, which reads them there at start and imports the definitions in module scope.
    -->
    <None Include="module.json" CopyToOutputDirectory="PreserveNewest" Link="modules/software/module.json" />
    <None Include="definitions/**/*.json" CopyToOutputDirectory="PreserveNewest" Link="modules/software/definitions/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Coanda.Tests" />
  </ItemGroup>

</Project>
