<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Coanda.Daemon</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- ed25519 for the node key and the signed line; .NET has no standalone Ed25519 type. -->
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="Fisher" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Coanda.Core\Coanda.Core.csproj" />
    <ProjectReference Include="..\Coanda.Sdk\Coanda.Sdk.csproj" />
    <!-- The software module, hosted in process until phase 5 starts it as a process of its own. -->
    <ProjectReference Include="..\Coanda.Modules.Software\Coanda.Modules.Software.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The module API's manifest schema, which a module's module.json is checked against when it is read. -->
    <EmbeddedResource Include="..\..\schemas\module\v1\manifest.schema.json" LogicalName="Coanda.Daemon.Modules.manifest.schema.json" />
    <!-- The module API's feed delivery schema, which every feed delivery is checked against before it is sent. -->
    <EmbeddedResource Include="..\..\schemas\module\v1\feed-delivery.schema.json" LogicalName="Coanda.Daemon.Modules.feed-delivery.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Coanda.Tests" />
    <!-- The CLI starts its daemon with the executor's detached launcher. -->
    <InternalsVisibleTo Include="coa" />
  </ItemGroup>

</Project>
